# Copy this file to .env. If Windows has reserved port 11434, set this to the
# OLLAMA_HOST port configured in your Windows user environment (for example 21434).
DOCUMIND_OLLAMA_PORT=11434

# Ollama model configuration
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_VECTOR_DIM=768

# Qdrant Vector DB
QDRANT_HOST=http://qdrant_service:6333
QDRANT_PORT=6333

# Application Upload Limits
MAX_UPLOAD_MB=50

# Relational Database URL (Container internal path mapped via volume)
DB_URL=sqlite:////workspace/db_data/pdf_summarizer.db
