# Copy this file to .env. If Windows has reserved port 11434, set this to the
# OLLAMA_HOST port configured in your Windows user environment (for example 21434).
DOCUMIND_OLLAMA_PORT=11434

# Ollama model configuration
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
EMBED_VECTOR_DIM=1024
DOCUMIND_QDRANT_COLLECTION=pdf_chunks_bge_m3_1024
DOCUMIND_LOCAL_ONLY=1

# Applied only when launcher.py starts a local Ollama server itself. Existing
# servers keep their own settings. DocuMind requests always specify an 8K context.
DOCUMIND_OLLAMA_FLASH_ATTENTION=1
DOCUMIND_OLLAMA_KV_CACHE_TYPE=f16

# Qdrant Vector DB
QDRANT_HOST=http://qdrant_service:6333
QDRANT_PORT=6333

# Application Upload Limits
MAX_UPLOAD_MB=50

# PDF work runs in separate processes. Pending includes running and queued work.
PDF_PROCESS_WORKERS=2
PDF_MAX_PENDING=8

# Relational Database URL (Container internal path mapped via volume)
DB_URL=sqlite:////workspace/db_data/pdf_summarizer.db
DOCUMIND_UI=next
DOCUMIND_FRONTEND_URL=http://127.0.0.1:4317
